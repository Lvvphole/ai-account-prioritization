# ---------------------------------------------------------------------------
# AI Account Prioritization Agent — environment template
# Copy to .env and fill in. NEVER commit a real .env or real secrets.
# The deterministic runtime path requires NONE of these to be set; absent
# integrations degrade to in-memory/mock so the core loop stays runnable.
# ---------------------------------------------------------------------------

# --- Supabase (database, auth, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- LLM judge (async eval only; never ranking) ---
# Without ANTHROPIC_API_KEY the judge stays on the deterministic heuristic.
ANTHROPIC_API_KEY=
EVAL_JUDGE_MODEL=

# --- Runtime drafting (bounded generation only; never ranking or authority) ---
# Runtime drafting stays disabled unless explicitly enabled. The common contract
# recognizes anthropic, openai, and google, but P4 Unit 1 admits only the
# Anthropic production adapter. Selecting a provider without an admitted adapter
# fails closed; there is no provider routing or silent provider fallback.
# The provider key and exact model id are mandatory when enabled. Input/output,
# evidence freshness, evidence count, concurrency, and whole-run token spend are
# bounded independently. Reasoning effort is a provider-neutral intent; adapters
# must reject unsupported mappings rather than claim cross-provider equivalence.
# Boolean values are strict: use only true or false. Keep this credential separate
# from the async judge key.
RUNTIME_DRAFTING_ENABLED=false
RUNTIME_DRAFT_PROVIDER=anthropic
RUNTIME_DRAFT_API_KEY=
RUNTIME_DRAFT_MODEL=
RUNTIME_DRAFT_REASONING_EFFORT=provider_default
RUNTIME_DRAFT_TIMEOUT_MS=5000
RUNTIME_DRAFT_MAX_TOKENS=600
RUNTIME_DRAFT_MAX_INPUT_TOKENS=4000
RUNTIME_DRAFT_MAX_SIGNALS=6
RUNTIME_DRAFT_MAX_EVIDENCE_AGE_DAYS=90
RUNTIME_DRAFT_MAX_CONCURRENT=4
RUNTIME_DRAFT_MAX_RUN_TOKENS=20000
RUNTIME_DRAFT_FALLBACK=template

# --- Sentry (Python service errors; env-gated, runs without it) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Langfuse (Python service tracing; env-gated, runs without it) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- CRM source (absent => in-memory mock) ---
CRM_BASE_URL=
CRM_API_KEY=

# --- Runtime toggles ---
EVAL_JUDGE_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true
