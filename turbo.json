{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "EVAL_JUDGE_ENABLED",
    "ANTHROPIC_API_KEY",
    "EVAL_JUDGE_MODEL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "P4_PRODUCTION_MODEL_ADMISSION",
    "RUNTIME_DRAFTING_ENABLED",
    "RUNTIME_DRAFT_PROVIDER",
    "RUNTIME_DRAFT_API_KEY",
    "RUNTIME_DRAFT_MODEL",
    "RUNTIME_DRAFT_REASONING_EFFORT",
    "RUNTIME_DRAFT_TIMEOUT_MS",
    "RUNTIME_DRAFT_MAX_TOKENS",
    "RUNTIME_DRAFT_MAX_INPUT_TOKENS",
    "RUNTIME_DRAFT_MAX_SIGNALS",
    "RUNTIME_DRAFT_MAX_EVIDENCE_AGE_DAYS",
    "RUNTIME_DRAFT_MAX_CONCURRENT",
    "RUNTIME_DRAFT_MAX_RUN_TOKENS",
    "RUNTIME_DRAFT_FALLBACK",
    "VERIFY_ACCEPTANCE_B_RUNTIME",
    "ACCEPTANCE_B_DATABASE_BACKED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:evals": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:acceptance:a": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:acceptance:b": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:trajectory": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:judge": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "generate": {
      "outputs": ["generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
