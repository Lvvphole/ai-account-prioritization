      "sources": [
        "REQ3:Ch11-Complete",
        "REQ3:Ch11-Consistent",
        "REQ3:Ch1-Iteration",
        "REQ3:Ch11-TBD"
      ]
    },
    {
      "id": "REQ-007",
      "domain": "requirements",
      "level": "CONDITIONAL",
      "delivery": "preload",
      "instruction": "Where requirement, implementation, and test artifacts exist, preserve traceability from authoritative source to requirement to changed implementation and verification evidence.",
      "applies_to": {
        "profiles": [
