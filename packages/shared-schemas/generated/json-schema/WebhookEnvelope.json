{
  "$ref": "#/definitions/WebhookEnvelope",
  "definitions": {
    "WebhookEnvelope": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "record": {
          "type": "object",
          "properties": {
            "objectType": {
              "type": "string",
              "enum": [
                "account",
                "contact",
                "opportunity",
                "activity",
                "intent_signal",
                "account_health",
                "contract"
              ]
            },
            "externalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "accountExternalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "changedFields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "previous": {},
                  "current": {}
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "objectType",
            "externalId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "workspaceId",
        "sourceId",
        "eventType",
        "occurredAt",
        "schemaVersion",
        "record"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
