{
  "$ref": "#/definitions/SourceMappingVersion",
  "definitions": {
    "SourceMappingVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "validated",
            "published",
            "superseded"
          ]
        },
        "createdBy": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "workspaceId",
        "sourceId",
        "version",
        "state",
        "createdBy",
        "createdAt",
        "publishedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
