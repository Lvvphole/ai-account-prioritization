{
  "$ref": "#/definitions/IngestionFile",
  "definitions": {
    "IngestionFile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "batchId": {
          "type": "string",
          "format": "uuid"
        },
        "storagePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "originalFilename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scanStatus": {
          "type": "string",
          "enum": [
            "pending",
            "clean",
            "infected",
            "unavailable"
          ]
        },
        "scannedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "batchId",
        "storagePath",
        "originalFilename",
        "byteSize",
        "sha256",
        "scanStatus",
        "scannedAt",
        "uploadedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
