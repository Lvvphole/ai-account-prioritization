            "requested",
            "conflicted",
            "applied",
            "partially_applied",
            "denied"
          ]
        },
        "conflictCount": {
          "type": "integer",
          "minimum": 0
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "originalCommitId",
        "compensatingCommitId",
        "requestedBy",
        "businessReason",
        "state",
        "conflictCount",
        "requestedAt"
