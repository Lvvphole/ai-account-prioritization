        "id": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "originalCommitId": {
          "type": "string",
          "format": "uuid"
        },
        "compensatingCommitId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedBy": {
          "type": "string",
          "format": "uuid"
        },
        "businessReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "state": {
          "type": "string",
