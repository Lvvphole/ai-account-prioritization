{
  "$ref": "#/definitions/SourceCredentialReference",
  "definitions": {
    "SourceCredentialReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "credentialType": {
          "type": "string",
          "enum": [
            "oauth",
            "hmac_signing_secret",
            "bearer_token"
          ]
        },
        "providerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "rotatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "workspaceId",
        "sourceId",
        "credentialType",
        "providerRef",
        "fingerprint",
        "createdAt",
        "rotatedAt",
        "expiresAt",
        "revokedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
