#!/usr/bin/env bash
set -euo pipefail

rows_seen=0
content_refs=0

is_zero_oid() {
  [[ "$1" =~ ^0+$ ]]
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  rows_seen=1

  if is_zero_oid "$local_sha"; then
    continue
  fi

  content_refs=1
  if is_zero_oid "$remote_sha"; then
    bash scripts/scan-secrets.sh --range "$local_sha"
  else
    bash scripts/scan-secrets.sh --range "$remote_sha..$local_sha"
  fi
done

if [ "$rows_seen" -eq 0 ]; then
  echo "BLOCKED: pre-push did not receive Git ref data."
  exit 2
fi

if [ "$content_refs" -eq 0 ]; then
  echo "PRECHECK PASS: deletion-only push has no outgoing content."
  exit 0
fi

echo "PRECHECK PASS: outgoing Git objects contain no detected secrets."
echo "This hook is bypassable and is not Tier-3 completion."
