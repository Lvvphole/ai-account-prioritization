#!/usr/bin/env bash
# Local pre-push PRECHECK. This is NOT Tier-3 completion verification.
#
# Canonical completion verification is `pnpm verify:production` (AGENTS.md §13.3).
# It requires Docker and is executed remotely by the "Pre-PR Production Verification"
# and "PR Production Verification" jobs in .github/workflows/production-verification.yml.
# Those remote runs are authoritative; this hook is not.
#
# Scope is deliberately narrow: catch cheap, deterministic, local failures before they
# consume a remote run. Secret scanning is included despite the speed goal because a
# secret that reaches the remote is compromised even if later removed, so remote
# detection would be too late. Do not add schema generation, Docker, Acceptance A, or
# the full test suite here.
#
# Git supplies "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
# The scan covers every commit actually being pushed, not just the tip: a branch that
# adds a secret in one commit and removes it in a later one would pass a tip-only scan
# while uploading the secret-bearing commit.
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REMOTE_NAME="${1:-origin}"

# A ref the remote does not have yet: git will upload everything reachable from the
# tip that the remote lacks, so the scan must cover the same set.
#
# refs/remotes/<remote>/* cannot define that set. Those are a local cache from the
# last fetch, and they survive `git remote set-url` — so after a remote is repointed
# they describe a different repository entirely, and excluding them hides commits the
# new remote has never seen. Verified: a secret pushed to repo A, origin repointed to
# empty repo B, then a new branch pushed — the scan reported "no outgoing commits"
# and B received the secret.
#
# So ask the remote what it actually advertises. Anything we cannot establish is not
# excluded: an unreachable remote, or an advertised commit absent locally, only
# widens the scan, never narrows it.
scan_new_ref() {
  local local_sha="$1" remote="$2"
  local listing sha _rest
  local -a exclusions=()

  if listing="$(git ls-remote --heads --tags "$remote" 2>/dev/null)"; then
    while read -r sha _rest; do
      [ -n "${sha:-}" ] || continue
      # Only objects present locally can be exclusions; a missing one would make
      # rev-list fail, and omitting it is safe.
      if git cat-file -e "${sha}^{commit}" 2>/dev/null; then
        exclusions+=("$sha")
      fi
    done <<< "$listing"
  else
    echo "==> Cannot list refs on '$remote'; scanning all history reachable from the new ref"
  fi

  if [ "${#exclusions[@]}" -gt 0 ]; then
    bash scripts/scan-secrets.sh --range "$local_sha" --not "${exclusions[@]}"
  else
    bash scripts/scan-secrets.sh --range "$local_sha"
  fi
}

echo "==> Local pre-push precheck (not Tier-3 completion verification)"

# Two separate questions. "Did git hand us any ref rows?" distinguishes a real push
# from a manual invocation. "Did any row carry content?" distinguishes a deletion-only
# push from one that uploads commits. Collapsing them into a single flag makes a
# deletion-only push look like a manual run.
rows_seen=0
content_refs=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  rows_seen=1

  # Deleting a remote ref uploads no content.
  [ "$local_sha" = "$ZERO" ] && continue
  content_refs=1

  if [ "$remote_sha" = "$ZERO" ]; then
    scan_new_ref "$local_sha" "$REMOTE_NAME"
  else
    bash scripts/scan-secrets.sh --range "$remote_sha..$local_sha"
  fi
done

# A push that only deletes refs sends nothing, so there is nothing to precheck — not
# the history (none is uploaded) and not the working tree (unrelated to the operation).
# Running the checks anyway would block `git push --delete` whenever the local tree
# happens to be mid-edit, which has nothing to do with removing a remote branch.
if [ "$rows_seen" -eq 1 ] && [ "$content_refs" -eq 0 ]; then
  echo "==> Deletion-only push; no content is being sent, nothing to precheck"
  echo
  echo "PRECHECK PASS"
  echo "Not Tier-3 completion."
  echo "Remote production verification is authoritative."
  exit 0
fi

# Run by hand rather than by git: no ref pairs arrived at all, so fall back to the
# tip scan. Guarded on rows_seen, not on whether anything was scanned.
if [ "$rows_seen" -eq 0 ]; then
  bash scripts/scan-secrets.sh
fi

pnpm lint
pnpm typecheck

echo
echo "PRECHECK PASS"
echo "Not Tier-3 completion."
echo "Remote production verification is authoritative."
